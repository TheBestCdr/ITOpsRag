# Copy to .env for local development. Never commit .env.

# ---- Application ----
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- Corpus (Kaggle AgentEval Part I) ----
# Point this at the folder containing corpus.csv / train.csv / test.csv.
DATA_DIR=agent-eval-part-i-grounded-rag-benchmark
EXPECTED_DOCS=1200
EXPECTED_CHUNKS=3600

# ---- Retrieval ----
# local  = in-process BM25 + MiniLM (notebook parity, no Azure needed)
# azure  = Azure AI Search
RETRIEVER_BACKEND=local
TOP_K=5
USE_TITLE_ANCHOR=true
MIN_SIMILARITY=0.35

# ---- Embeddings ----
# local = sentence-transformers all-MiniLM-L6-v2 (384 dims)
# azure = Azure OpenAI text-embedding-3-small
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_DIMENSIONS=512

# ---- Answer generation ----
# extractive   = notebook behaviour, no LLM
# azure_openai = grounded LLM answer with citations
GENERATOR_BACKEND=extractive
AZURE_CHAT_DEPLOYMENT=gpt-4o-mini
MAX_OUTPUT_TOKENS=400
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2

# ---- Azure OpenAI (only needed when the azure backends are selected) ----
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=            # omit to use managed identity / az login

# ---- Azure AI Search (only needed when RETRIEVER_BACKEND=azure) ----
# AZURE_SEARCH_ENDPOINT=https://your-service.search.windows.net
# AZURE_SEARCH_INDEX=itops-chunks
# AZURE_SEARCH_API_KEY=            # omit to use managed identity / az login

# ---- Observability (optional) ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=itops-rag
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- API protection ----
# Leave API_KEY empty for local development. Set it in Azure.
# API_KEY=
RATE_LIMIT_PER_MINUTE=30
DAILY_REQUEST_CAP=2000
KILL_SWITCH=false

# ---- Frontend ----
WEB_DIST_DIR=web/dist
